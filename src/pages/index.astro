<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Data Analyst & Aspiring Data Scientist | Portfolio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-color: #FAFAFC;
      --text-main: #0F172A;
      --text-muted: #475569;
      --accent-blue: #2563EB;
      --border-color: #E2E8F0;
      --card-bg: #FFFFFF;
      --font-mono: 'JetBrains Mono', monospace;
      --font-body: 'Inter', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: var(--font-body);
      line-height: 1.6;
      padding: 40px 20px;
    }

    .container {
      max-width: 720px;
      margin: 0 auto;
    }

    .profile-header {
      margin-bottom: 32px;
    }

    .name {
      font-family: var(--font-mono);
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .subtitle {
      color: var(--accent-blue);
      font-weight: 600;
      margin-bottom: 16px;
    }

    .bio {
      color: var(--text-muted);
      font-size: 1rem;
      margin-bottom: 24px;
    }

    .links-group {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      display: inline-block;
      padding: 8px 16px;
      border-radius: 6px;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: opacity 0.2s;
    }

    .btn-primary {
      background-color: var(--accent-blue);
      color: white;
    }

    .btn-secondary {
      background-color: transparent;
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    .btn:hover {
      opacity: 0.85;
    }

    .divider {
      border: none;
      border-top: 1px solid var(--border-color);
      margin: 32px 0;
    }

    .section-title {
      font-family: var(--font-mono);
      font-size: 1.25rem;
      margin-bottom: 20px;
    }

    .project-card {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 24px;
      margin-bottom: 32px;
    }

    .project-tag {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent-blue);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }

    .project-header {
      font-size: 1.15rem;
      margin-bottom: 12px;
    }

    .project-desc {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-bottom: 16px;
    }

    .tech-stack {
      display: flex;
      flex-wrap: wrap;
      list-style: none;
      gap: 8px;
      margin-bottom: 20px;
    }

    .tech-stack li {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      background-color: var(--bg-color);
      border: 1px solid var(--border-color);
      padding: 4px 10px;
      border-radius: 4px;
    }

    .project-links a {
      color: var(--accent-blue);
      text-decoration: none;
      font-weight: 500;
      margin-right: 16px;
      font-size: 0.9rem;
    }

    .placeholder-card {
      border: 1px dashed var(--border-color);
      padding: 20px;
      border-radius: 8px;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .badge-notice {
      margin-top: 8px;
      font-size: 0.85rem;
    }

    .footer {
      margin-top: 48px;
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <main class="container">
    <!-- Profile Header & Positioning -->
    <header class="profile-header">
      <h1 class="name">Data Analyst</h1>
      <p class="subtitle">Data Analyst & Aspiring Data Scientist</p>
      <p class="bio">
        Specializing in machine learning pipelines, tabular data hygiene audits, and dynamic statistical evaluation. Experienced in building scalable end-to-end data workflows.
      </p>
      
      <!-- Working Links -->
      <div class="links-group">
        <a href="https://github.com/mohamedkhaled600" target="_blank" class="btn btn-primary">GitHub Profile</a>
        <a href="https://www.linkedin.com/in/mohamedkhaled99/" target="_blank" class="btn btn-secondary">LinkedIn Profile</a>
        <a href="cv.pdf" download="YourName_CV.pdf" target="_blank" class="btn btn-secondary">Download CV</a>
        <a href="mailto:mohamedkhaaled51@gmail.com" class="btn btn-secondary">Contact / Booking</a>
      </div>
    </header>

    <hr class="divider">

    <!-- Flagship Project Showcase -->
    <section class="projects-section">
      <h2 class="section-title">Featured Project</h2>

      <article class="project-card">
        <div class="project-tag">Machine Learning Pipeline</div>
        <h3 class="project-header">500k Craigslist Used Car Price Prediction Pipeline</h3>
        <p class="project-desc">
          An end-to-end ML pipeline built to clean and value 500k+ noisy vehicle listings. Implemented dynamic IQR price outlier clipping ($20k–$250k bounds), frequency encoding for high-cardinality features.
        </p>
        <ul class="tech-stack">
          <li>Python</li>
          <li>Pandas</li>
          <li>CatBoost</li>
          <li>Scikit-Learn</li>
          <li>Streamlit</li>
        </ul>
        <div class="project-links">
          <a href="https://usedcarsprediction-mqv4gpyvuyyp4evwfakcxh.streamlit.app/" target="_blank">Live App &rarr;</a>
          <a href="https://github.com/mohamedkhaled600/Used_Cars_Prediction" target="_blank">Source Code &rarr;</a>
        </div>
      </article>
    </section>

    <!-- Space for Future Capstone & FlyRank Badge -->
    <section class="capstone-space">
      <h2 class="section-title">Capstone & Recognitions</h2>
      <div class="placeholder-card">
        <p><strong>Capstone Agent Project (In Progress):</strong> Automated Dataset & Model Drift Scout Agent.</p>
        <p class="badge-notice"><em>FlyRank Official Completion Badge will be added here upon capstone approval.</em></p>
      </div>
    </section>

    <footer class="footer">
      <p>&copy; 2026 • Deployed on Vercel over HTTPS</p>
    </footer>
  </main>

</body>
</html>
